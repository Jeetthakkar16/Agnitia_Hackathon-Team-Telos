{
  "name": "aavra-saaya-core",
  "version": "13.0.0-prototype",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3010",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3010",
    "typecheck": "tsc --noEmit",
    "lint": "node scripts/qa.mjs",
    "mobile:build": "next build",
    "mobile:sync": "cap sync",
    "mobile:android": "cap open android",
    "mobile:ios": "cap open ios",
    "db:generate": "drizzle-kit generate",
    "qa": "node scripts/qa.mjs",
    "test:pure": "node scripts/test-pure.mjs",
    "postinstall": "node scripts/copy-maplibre-worker.mjs",
    "vercel-build": "next build",
    "check": "npm run typecheck && npm run qa && npm run test:pure",
    "test:focus": "node scripts/test-focused-lanes.mjs",
    "test:street": "node scripts/test-isothermal-roads.mjs",
    "test:names": "node scripts/test-street-names.mjs",
    "test:search": "node --experimental-strip-types scripts/test-search-box.mjs",
    "test:toolkit": "node --experimental-strip-types scripts/test-field-tools.mjs",
    "test:selected-streets": "node --experimental-strip-types scripts/test-selected-streets.mjs",
    "test:platform": "node --experimental-strip-types scripts/test-platform.mjs",
    "test:all": "node --experimental-strip-types scripts/test-v9-actions.mjs && node --experimental-strip-types scripts/test-v8.mjs && node --experimental-strip-types scripts/test-occupation.mjs && node --experimental-strip-types scripts/test-guidance.mjs && node scripts/qa.mjs && node scripts/test-pure.mjs && node scripts/test-focused-lanes.mjs && node scripts/test-isothermal-roads.mjs && node scripts/test-street-names.mjs && node --experimental-strip-types scripts/test-selected-streets.mjs && node --experimental-strip-types scripts/test-search-box.mjs && node --experimental-strip-types scripts/test-field-tools.mjs && node --experimental-strip-types scripts/test-platform.mjs && npm run test:ui && npm run test:isotherms",
    "test:ui": "node --experimental-strip-types scripts/test-unified-ui.mjs",
    "test:v4": "node --experimental-strip-types scripts/test-v4-experience.mjs && node scripts/check-v4-syntax.mjs",
    "test:isotherms": "node --experimental-strip-types scripts/test-isotherm-contours.mjs",
    "test:guidance": "node --experimental-strip-types scripts/test-guidance.mjs",
    "test:occupation": "node --experimental-strip-types scripts/test-occupation.mjs",
    "test:v8": "node --experimental-strip-types scripts/test-v8.mjs",
    "test:v9": "node --experimental-strip-types scripts/test-v9-actions.mjs",
    "test:v10": "node --experimental-strip-types scripts/test-v10-simple.mjs",
    "native:android:prepare": "node scripts/native-prepare.mjs android",
    "native:ios:prepare": "node scripts/native-prepare.mjs ios",
    "test:core": "node --test scripts/test-saaya-core.mjs"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/geolocation": "^8.2.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/local-notifications": "^8.0.0",
    "@capacitor/push-notifications": "^8.0.0",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.53.0",
    "maplibre-gl": "^6.13.0",
    "next": "16.3.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "drizzle-kit": "0.31.10",
    "typescript": "5.9.3"
