# A MapTiler key is optional; the default OpenFreeMap map is keyless.
NEXT_PUBLIC_MAPTILER_KEY=

# Optional Supabase email login (OTP code or redirect link). NOT configured by default.
# Supabase email template must be configured to send either a one-time code or compatible access-token fragment.
# The web client stores only a temporary browser session; this does not add server-side user authorization.
# Configure redirect URLs for your HTTPS deployment in Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
